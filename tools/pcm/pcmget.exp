#!/usr/bin/expect -f
set timeout 180
set pwfile [lindex $argv 0]
set remote [lindex $argv 1]
set local  [lindex $argv 2]
set fh [open $pwfile r]; set pw [read -nonewline $fh]; close $fh
log_user 0
spawn scp -O -o StrictHostKeyChecking=no -o HostKeyAlgorithms=+ssh-rsa \
  -o PubkeyAcceptedAlgorithms=+ssh-rsa root@PCM_IP:$remote $local
expect {
  -re {[Pp]assword:} { send "$pw\r" }
  timeout { puts "TIMEOUT_PW"; exit 2 }
  eof { puts "EOF_PW"; exit 2 }
}
expect eof
catch wait result
exit [lindex $result 3]
